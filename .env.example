# ═══════════════════════════════════════════════════════════════════════
#  Audiovisual-Transporter — all configuration
#
#  Copy this file to `.env` and fill in the blanks.
#  `.env` is git-ignored. Never commit real credentials.
#
#  Paths:
#    · Douban RSS  → Notion / NeoDB / Bangumi   (legacy, from douban-backup)
#    · Bangumi     → NeoDB                      (legacy)
#    · NeoDB shelf → TMDB                       (new, OFF by default)
# ═══════════════════════════════════════════════════════════════════════

# ─── Douban RSS (needed for any Douban → * path) ────────────────────────
# Your numeric Douban user id, from your profile URL.
DOUBAN_USER_ID=

# ─── Legacy sync path switches ──────────────────────────────────────────
# 1/true/on = enable, 0/false/off = disable.
# Defaults: Notion off; the other three on.
SYNC_DOUBAN_NOTION=0
SYNC_DOUBAN_NEODB=1
SYNC_DOUBAN_BANGUMI=1
# Write Bangumi progress for Douban items whose status is complete. Default off.
#   books: max out the known Chap./Vol. dimension; unknown dimensions are not written
#   movies/TV: mark missing main episodes; existing episode timestamps are not touched
SYNC_DOUBAN_BANGUMI_EPISODES=0
# Include SP episodes when writing TV/anime/real progress. Default off; movies never include SP.
SYNC_DOUBAN_BANGUMI_INCLUDE_SP=0
# Include OP/ED theme episodes when writing TV/anime/real progress. Default off; movies never include them.
# This is not story progress: "complete" does not prove the user watched every OP/ED.
SYNC_DOUBAN_BANGUMI_INCLUDE_OP_ED=0
SYNC_BANGUMI_NEODB=1

# Whether a Douban RSS failure fails the whole run.
#   1 (default) = yes: an enabled Douban path that cannot run is a real failure
#   0           = no: the failure is still printed and still listed in the job
#                 summary as TOLERATED, but it does not decide the exit code.
# Use 0 only when the feed is known-unreachable from the current network
# (Douban blocks CI address ranges) and you still want the other paths to pass.
# SYNC_DOUBAN_REQUIRED=1

# Override the User-Agent for the Douban RSS feed and subject pages.
# DOUBAN_RSS_USER_AGENT=

# Category allowlists (comma-separated). Empty = all categories for that path.
# Douban paths: movie, music, book, game, drama
# Bangumi→NeoDB: anime, manga, book, music, game, real
# SYNC_DOUBAN_NOTION_CATEGORIES=
# SYNC_DOUBAN_NEODB_CATEGORIES=
# SYNC_DOUBAN_BANGUMI_CATEGORIES=
# SYNC_BANGUMI_NEODB_CATEGORIES=anime,manga,game

# NeoDB mark merge: rating and comment are independent switches.
#   neodb_prefer = keep the existing non-zero rating / non-empty comment (default)
#   overwrite    = always write the source value
# SYNC_DOUBAN_NEODB_RATING=neodb_prefer
# SYNC_DOUBAN_NEODB_COMMENT=neodb_prefer
# SYNC_BANGUMI_NEODB_RATING=neodb_prefer
# SYNC_BANGUMI_NEODB_COMMENT=neodb_prefer
# NeoDB mark time: status / initial-source / always-source.
#   status         = new uses source; same status keeps target; status change uses source
#   initial-source = only new marks use source; existing marks keep target
#   always-source  = every write uses source
# SYNC_DOUBAN_NEODB_MARK_TIME_POLICY=status
# SYNC_BANGUMI_NEODB_MARK_TIME_POLICY=status
# Douban → Bangumi: rating and comment also have independent switches.
#   bangumi_prefer = keep the existing non-zero rating / non-empty comment (default)
#   overwrite      = always write the Douban value
# SYNC_DOUBAN_BANGUMI_RATING=bangumi_prefer
# SYNC_DOUBAN_BANGUMI_COMMENT=bangumi_prefer
# Bangumi → NeoDB progress (episode/chapter/track); default off
# SYNC_BANGUMI_NEODB_PROGRESS=0
# Optional: refuse to downgrade an existing "complete" mark from Bangumi.
#   off (default)   = source still wins, so users can correct a status
#   no-downgrade    = complete is kept over progress/wishlist (ratings still merge)
# SYNC_BANGUMI_NEODB_STATUS_GUARD=off
# Mark time follows SYNC_BANGUMI_NEODB_MARK_TIME_POLICY above.
# Bangumi only has updated_at (last edit), not a status-marked-at field.

# ─── Notion (only if SYNC_DOUBAN_NOTION=1) ──────────────────────────────
NOTION_TOKEN=
NOTION_MOVIE_DATABASE_ID=
NOTION_MUSIC_DATABASE_ID=
NOTION_BOOK_DATABASE_ID=
NOTION_GAME_DATABASE_ID=
NOTION_DRAMA_DATABASE_ID=

# ─── NeoDB (shared by every path that reads or writes NeoDB) ────────────
# Get a token: log in to your instance → /developer/ → Authorize.
NEODB_API_TOKEN=
# Mark visibility used when writing: 0=公开, 1=仅关注者, 2=私密 (default)
NEODB_VISIBILITY=2
# Self-hosted NeoDB: point this at your instance.
# NEODB_BASE_URL=https://neodb.social
# Delay between shelf requests, milliseconds.
# NEODB_REQUEST_DELAY_MS=300
# Safety cap on pages walked per shelf×category combination. Pages are processed as they
# arrive, so the walk stops early once SYNC_MAX_ITEMS is reached.
# NEODB_MAX_PAGES=10

# ─── Bangumi (Douban→Bangumi and/or Bangumi→NeoDB) ─────────────────────
BANGUMI_ACCESS_TOKEN=
# BANGUMI_PRIVATE=false
# BANGUMI_COLLECTION_LIMIT=50
# BANGUMI_USER_AGENT=
# 遍历全部分页（默认只取第一页 50 条）。CI 里手动触发时可勾选 BANGUMI_NEODB_FULL_SYNC 覆盖本值；
# 本项只对那次运行生效，不会残留到定时任务。
# BANGUMI_NEODB_FULL_SYNC=0
# 全量遍历的游标：只有全量读写它，常规运行一律从头开始。删掉本文件即「重新从头走一遍」。
# BANGUMI_NEODB_FULL_SYNC_STATE=.cache/bangumi-neodb-full-sync.json

# ═══════════════════════════════════════════════════════════════════════
#  NeoDB shelf → TMDB   (new path, OFF by default)
# ═══════════════════════════════════════════════════════════════════════

# Master switch for the NeoDB → TMDB path.
SYNC_NEODB_TMDB=0

# ─── TMDB credentials ──────────────────────────────────────────────────
# v3 API key — themoviedb.org → Settings → API. Used to address requests.
TMDB_API_KEY=

# Write access needs ONE of these two (either works):
#   TMDB_SESSION_ID   — a v3 session id
#   TMDB_ACCESS_TOKEN — a user-scoped v4 token
#
# The token is tried as a session source first; when that conversion is
# unavailable it is used directly as a Bearer credential.
# Note: a "scopes":["api_read"] claim does NOT mean the token is read-only —
# verified user-scoped tokens carrying that claim still write successfully.
TMDB_SESSION_ID=
TMDB_ACCESS_TOKEN=

# Optional. Fetched from /3/account when omitted.
# TMDB_ACCOUNT_ID=

# TMDB_LANGUAGE=zh-CN
# TMDB_REQUEST_DELAY_MS=300
# TMDB_INCLUDE_ADULT=false
# TMDB_BASE_URL=https://api.themoviedb.org/3

# ─── NeoDB → TMDB behaviour ────────────────────────────────────────────
# Which shelves to process. Default: wishlist, progress, complete, dropped.
# `dropped` maps to the watchlist exactly like `progress` — see src/rules/tmdb-mapping.ts.
# SYNC_SHELF_TYPES=wishlist,progress,complete,dropped

# Category allowlist. Only movie/tv can exist on TMDB.
# SYNC_CATEGORIES=movie,tv

# 1 = compute and log the plan, write nothing to TMDB.
# SYNC_DRY_RUN=0

# Safety cap on items processed per shelf×category combination. Counts items that
# actually reach TMDB (after the category gates and the incremental skip), not marks
# walked. With the default four shelves × two categories the run ceiling is 4×2×50=400.
# SYNC_MAX_ITEMS=50

# Full sync: 1 = ignore SYNC_MAX_ITEMS / NEODB_MAX_PAGES and skip
# SYNC_INCREMENTAL for this run. Use it for the first import — ideally after a
# SYNC_DRY_RUN=1 pass — or just run `npm run sync:neodb-tmdb-full-sync`, which
# always does this. Shelf and category selections still apply.
# NOTE: SYNC_MAX_ITEMS=0 is NOT "unlimited" — values below 1 fall back to 50.
# NEODB_TMDB_FULL_SYNC=0

# When both sides have a rating:
#   tmdb_prefer = keep a non-zero TMDB rating (safe first run)  ← default
#   overwrite   = push the NeoDB one
# SYNC_NEODB_TMDB_RATING=tmdb_prefer

# Allowed |search year − NeoDB year| when matching by title.
# SYNC_YEAR_TOLERANCE=1

# NeoDB uuid → release year cache used by ⑤'s title search. Safe to delete;
# CI starts empty every run because runners are ephemeral.
# NEODB_ITEM_YEAR_CACHE=.cache/neodb-item-years.json

# Incremental runs: skip marks whose fingerprint was already synced.
# The CI default is 0, not 1: `sync.yml` sets it that way because an Actions runner keeps no
# `.cache/` between runs, so an incremental store there would be empty every time.
# 注意 CI 侧默认是 0 而不是 1：`sync.yml` 这样设置，因为 Actions runner 不保留 `.env` 之外的
# `.cache/`，增量存储在那边每轮都是空的。
# SYNC_INCREMENTAL=1
# SYNC_STATE_FILE=.cache/sync-state.json

# ─── Review candidate verification (review-queue only) ─────────────────
# These five variables are read by `scripts/review-queue.mjs` in the review-queue workflow, NOT by
# `src/` and NOT by `npm run sync`. They are therefore absent here on purpose — `.env.example`
# documents what the sync process can read, and these cannot reach it. See
# `docs/configuration.md`（待核对候选的定向复核）for values and behaviour.
# 这五个变量由 review-queue 工作流里的 `scripts/review-queue.mjs` 读取，**不**被 `src/` 读，
# 也**不**被 `npm run sync` 读。因此这里刻意不列它们 —— `.env.example` 记录的是「同步进程能读到
# 什么」，而这几个到不了同步进程。取值与行为见 `docs/configuration.md`。

# ─── Shared review log ─────────────────────────────────────────────────
# Where entries a path could not process are recorded, for later review.
# Four paths write here; each entry carries a `source` field so they can
# share one file without ambiguity.
#
# Each entry's `reason` says *why* it could not be processed. The full table (slug → meaning →
# which path emits it → console line vs report only) is `docs/reference.md`（reason 总表）. Do not
# keep a copy here: a second list is a second thing to drift.
# 每条记录的 `reason` 说明它为什么没被处理。完整对照（slug → 含义 → 哪条链路产出 → 控制台行还是
# 仅报表）见 `docs/reference.md`（reason 总表）。不要在这里再抄一份：第二份清单就是第二处会漂移的地方。
#
# The three ⑤ slugs are named here on purpose, even though the table above covers them: they are the
# three that decide whether an item was *searched* at all, and `npm run verify:docs` asserts they
# appear in both `src/paths/neodb-to-tmdb.ts` and this file, so that a rename cannot silently drop
# the distinction between "looked and found nothing" and "never looked".
# 这五个字面量里，⑤ 的三个刻意点名在此：它们决定一个条目**到底有没有被搜过**，而
# `npm run verify:docs` 断言它们同时出现在 `src/paths/neodb-to-tmdb.ts` 与本文件，使一次改名无法
# 悄悄抹掉「找过但没有」与「根本没找」之间的区别。
#   no-tmdb-match              — searched every level, no TMDB counterpart
#   no-neodb-year              — NeoDB carries no year, so the title-search level never ran
#   no-neodb-year-fetch-failed — the year lookup itself failed (counted as `failed`, not `unresolved`)
#
# Writing is an upsert, not an append: re-failing on the same item keeps one
# entry and refreshes `lastSeenAt`, leaving `firstSeenAt` alone, so the file
# stays at the size of the unique set and a long-standing gap is still
# distinguishable from a newly appeared one.
#
# The value is a RELATIVE path, resolved against the process's working
# directory: `npm run sync` puts it at <repo>/.cache/unmatched.json, while
# running from anywhere else puts it there instead. The console prints the
# resolved absolute path.
#
# CI leaves this empty on purpose: the file cannot outlive the runner and
# nothing uploads it. There, the durable record is the 待核对名单 artifact
# produced by review-queue.yml.
#
# Empty disables the log (the counts and listing are still printed).
# SYNC_UNMATCHED_LOG=.cache/unmatched.json

# ─── Job summary ───────────────────────────────────────────────────────
# Where `npm run sync` leaves the Markdown report it renders at the end of a
# run. The file is always written (locally too); in Actions a separate step
# with `if: always()` appends it to $GITHUB_STEP_SUMMARY, so a failed sync still
# produces a readable summary instead of an empty panel.
#
# The value is a RELATIVE path, resolved like SYNC_UNMATCHED_LOG. It is
# overwritten every run, never appended to.
# SYNC_SUMMARY_FILE=.cache/sync-summary.md
# 同一份报表的机器可读版本；CI 里作为 artifact 上传，待核对名单用它做对账。
# SYNC_REPORT_FILE=.cache/sync-report.json
